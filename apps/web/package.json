{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:vercel": "cd ../.. && pnpm --filter @uag/sdk build && pnpm --filter @uag/core build && pnpm --filter @uag/provider-openrouter build && pnpm --filter @uag/provider-nvidia build && pnpm --filter @uag/operator build && pnpm --filter web build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@uag/core": "workspace:*",
    "@uag/operator": "workspace:*",
    "@uag/provider-nvidia": "workspace:*",
    "@uag/provider-openrouter": "workspace:*",
    "dotenv": "^17.4.2",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
