# Environment variables for Universal AI Gateway

# OpenRouter
OPENROUTER_API_KEY=

# NVIDIA
NVIDIA_API_KEY=

# MCP delegate timeout (ms). Free models may need 3-4 minutes.
UAG_DELEGATE_TIMEOUT_MS=300000

# Optional bearer token for the web operator console APIs.
# If set, all /api/* routes require: Authorization: Bearer <token>
UAG_WEB_TOKEN=

# Default Provider
DEFAULT_PROVIDER=openrouter

# Default Strategy
DEFAULT_STRATEGY=free
