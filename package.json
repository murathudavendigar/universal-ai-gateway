{
  "name": "universal-ai-gateway",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@uag/core": "workspace:*",
    "@uag/provider-openrouter": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "fastmcp": "^4.4.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
